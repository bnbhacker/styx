# Public Styx on the Elysium testnet, behind a Cloudflare tunnel (node --env-file=inverse-rh/engine/public.env).
# No secrets here: keeper keystore paths are added only after the pool is deployed.
NETWORK=elysium
# Visitors reach the engine through two proxies: Vercel (styxperps.xyz rewrites /api/*) and then Cloudflare's
# edge in front of cloudflared (or Caddy on a server). Each appends to X-Forwarded-For, so the visitor is the
# 2nd entry from the right. Requests without that header (a local browser) fall back to the socket peer.
STYX_TRUST_PROXY=2
# STYX_LOG_IP=N logs how the first N requests resolve to a client (checked 09.11: via Vercel = real visitor IP;
# straight to the tunnel host the header can be spoofed, so that host must stay unpublished)
# the $STYX token contract, shown on the site with a copy button: set it once the token is deployed
# STYX_TOKEN=0x...
